# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local testhunch history and CI report output
.testhunch/
reports/

# Local environment overrides
.env

# Downloaded benchmark data (benchmarks/)
.benchmark-cache/

# Terraform: the state holds the generated secrets in clear, and the providers are large.
# .terraform.lock.hcl is committed on purpose: it pins the providers to exact hashes.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
