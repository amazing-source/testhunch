#!/usr/bin/env bash
# First boot of the testhunch server: Docker, then Postgres, the migration and the API, as
# containers held by one systemd unit so a reboot brings them back.
#
# Its log is /var/log/testhunch-setup.log on the instance, and cloud-init's own is
# /var/log/cloud-init-output.log. Both are worth reading when the API does not answer.
set -euo pipefail
exec > >(tee -a /var/log/testhunch-setup.log) 2>&1

dnf -y install docker
systemctl enable --now docker

# Compose is not packaged for Amazon Linux 2023: the pinned release, as its own CLI plugin.
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

install -d -m 0750 /opt/testhunch

# The disk that outlives this instance (docs/adr/0024). Terraform attaches it after the instance
# exists, so it is not there at the first second of boot: wait for a disk that is not the root one.
# Identifying it by name would be a lie on Nitro, where /dev/sdf is presented as an NVMe device.
root_disk="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
for _ in $(seq 90); do
  data_disk="$(lsblk -dn -o NAME,TYPE | awk '$2 == "disk" { print $1 }' | grep -v "^$${root_disk}$" | head -1)"
  if [ -n "$${data_disk:-}" ]; then break; fi
  sleep 2
done
if [ -z "$${data_disk:-}" ]; then
  echo "::error title=testhunch::no data volume appeared" >&2
  exit 1
fi
device="/dev/$${data_disk}"

# Formatted only when it holds no filesystem: on every boot after the first, this volume already
# carries the database, and mkfs would be the one command that destroys what all of this protects.
if ! blkid "$${device}" > /dev/null 2>&1; then
  mkfs.ext4 -L testhunch-data "$${device}"
fi
install -d /var/lib/testhunch
grep -q 'LABEL=testhunch-data' /etc/fstab   || echo 'LABEL=testhunch-data /var/lib/testhunch ext4 defaults,nofail 0 2' >> /etc/fstab
mount -a
install -d /var/lib/testhunch/postgres /var/lib/testhunch/caddy /var/lib/testhunch/caddy-config
# Prometheus runs as uid 65534 in its image and writes its own data directory.
install -d -o 65534 -g 65534 /var/lib/testhunch/prometheus /var/lib/testhunch/alertmanager

# The secrets stay out of the instance's user data, which any process on the instance can read
# from the metadata service. They are fetched once, into a file only root can read.
postgres_password="$(aws ssm get-parameter --region '${region}' --name '${postgres_parameter}' \
  --with-decryption --query Parameter.Value --output text)"
api_token="$(aws ssm get-parameter --region '${region}' --name '${api_token_parameter}' \
  --with-decryption --query Parameter.Value --output text)"

# The image is read here and not written into this script, so that a deployment and a rebuild of
# this instance agree on what runs (docs/adr/0026). Compose reads it back from .env.
image="$(aws ssm get-parameter --region '${region}' --name '${image_parameter}' \
  --query Parameter.Value --output text)"

umask 077
cat > /opt/testhunch/.env <<EOF
POSTGRES_PASSWORD=$${postgres_password}
TESTHUNCH_API_TOKEN=$${api_token}
TESTHUNCH_DATABASE_URL=postgresql://testhunch:$${postgres_password}@postgres:5432/testhunch
TESTHUNCH_REPORTS_BUCKET=${reports_bucket}
TESTHUNCH_IMAGE=$${image}
EOF

%{ if api_domain != "" ~}
# Caddy answers on ${api_domain} and asks Let's Encrypt for the certificate itself, then renews it
# on its own. It reaches the API over the compose network, so the API still publishes nothing but
# its loopback port (docs/adr/0021).
#
# /metrics is not proxied. It names every repository the service knows, and it is for Prometheus,
# which reaches the API over the compose network and never through this (docs/adr/0027). The API
# refuses it without the operator token too: this is the outer of the two locks, not the only one.
cat > /opt/testhunch/Caddyfile <<'EOF'
${api_domain} {
	handle /metrics {
		respond 404
	}
	handle {
		reverse_proxy api:8000
	}
}
EOF
%{ endif ~}

# What Prometheus scrapes and what it complains about (docs/adr/0027). The token is the operator's,
# read from the same .env the API gets it from, so the two cannot drift apart.
# Prometheus and Alertmanager run as uid 65534, so the directory has to be enterable and the
# configuration readable by them. The token is the one file here that is not.
install -d -m 0755 /opt/testhunch/prometheus
printf '%s\n' "$${api_token}" > /opt/testhunch/prometheus/token
chown 65534:65534 /opt/testhunch/prometheus/token
chmod 0400 /opt/testhunch/prometheus/token

cat > /opt/testhunch/prometheus/prometheus.yml <<'EOF'
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules.yml
%{ if alert_email != "" ~}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]
%{ endif ~}

scrape_configs:
  - job_name: testhunch
    metrics_path: /metrics
    authorization:
      credentials_file: /etc/prometheus/token
    static_configs:
      - targets: ["api:8000"]

  - job_name: machine
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
EOF

cat > /opt/testhunch/prometheus/rules.yml <<'EOF'
groups:
  - name: testhunch
    rules:
      - alert: ApiDown
        expr: up{job="testhunch"} == 0
        for: 5m
        annotations:
          summary: "The API has not answered a scrape for five minutes."

      - alert: DatabaseDown
        expr: testhunch_database_up == 0
        for: 5m
        annotations:
          summary: "The API is up but Postgres does not answer."

      - alert: DataDiskFilling
        expr: >-
          node_filesystem_avail_bytes{mountpoint="/var/lib/testhunch"}
          / node_filesystem_size_bytes{mountpoint="/var/lib/testhunch"} < 0.15
        for: 15m
        annotations:
          summary: "Less than 15% left on the disk that holds the history."

      # The service level objective. Of the runs that went red, how many the half-time budget
      # would still have caught. Guarded on the count: a rate over three runs is not a rate,
      # and this project's own history says first failures are where it is weakest (ADR 0018).
      - alert: ShadowModeMissesTooMany
        expr: >-
          (
            sum by (repo) (testhunch_shadow_failing_runs{budget="0.5"})
            - sum by (repo) (testhunch_shadow_caught_runs{budget="0.5"})
          ) / sum by (repo) (testhunch_shadow_failing_runs{budget="0.5"}) > 0.1
          and sum by (repo) (testhunch_shadow_failing_runs{budget="0.5"}) >= 20
        for: 1h
        annotations:
          summary: "{{ $labels.repo }}: half the test time would miss more than one red build in ten."
EOF
%{ if alert_email != "" ~}

cat > /opt/testhunch/prometheus/alertmanager.yml <<'EOF'
route:
  receiver: sns
  group_wait: 1m
  group_interval: 10m
  repeat_interval: 24h

receivers:
  - name: sns
    sns_configs:
      # No credentials here: Alertmanager signs with the instance role (docs/adr/0027).
      - topic_arn: ${alerts_topic}
        sigv4:
          region: ${region}
        subject: '{{ .CommonLabels.alertname }}'
EOF
%{ endif ~}

# Written under umask 077, which is right for .env and wrong for these: they hold no secret and
# are read by a container that is not root.
chmod 0644 /opt/testhunch/prometheus/prometheus.yml /opt/testhunch/prometheus/rules.yml
%{ if alert_email != "" ~}
chmod 0644 /opt/testhunch/prometheus/alertmanager.yml
%{ endif ~}

# The API listens on the loopback only. Nothing routes to it from outside the instance, and the
# security group has no inbound rule either: reaching it means an SSM port forward.
cat > /opt/testhunch/compose.yaml <<'EOF'
services:
  postgres:
    image: ${postgres_image}
    restart: unless-stopped
    environment:
      POSTGRES_USER: testhunch
      POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
      POSTGRES_DB: testhunch
    volumes:
      - /var/lib/testhunch/postgres:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U testhunch -d testhunch"]
      interval: 5s
      timeout: 3s
      retries: 20

  migrate:
    image: $${TESTHUNCH_IMAGE}
    env_file: .env
    command: ["testhunch", "migrate"]
    depends_on:
      postgres:
        condition: service_healthy

  api:
    image: $${TESTHUNCH_IMAGE}
    restart: unless-stopped
    env_file: .env
    ports:
      - "127.0.0.1:8000:8000"
    depends_on:
      migrate:
        condition: service_completed_successfully
  prometheus:
    image: ${prometheus_image}
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=${metrics_retention}
      # Never let metrics be the reason the history runs out of disk.
      - --storage.tsdb.retention.size=2GB
      - --web.listen-address=0.0.0.0:9090
    volumes:
      - /opt/testhunch/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /opt/testhunch/prometheus/rules.yml:/etc/prometheus/rules.yml:ro
      - /opt/testhunch/prometheus/token:/etc/prometheus/token:ro
      - /var/lib/testhunch/prometheus:/prometheus
    ports:
      - "127.0.0.1:9090:9090" # loopback only: reach it with an SSM port forward

  node-exporter:
    image: ${node_exporter_image}
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      # The machine's disks and memory are the point; the rest is noise on one server.
      - --collector.disable-defaults
      - --collector.filesystem
      - --collector.meminfo
      - --collector.loadavg
    pid: host
    volumes:
      - /:/host:ro,rslave
%{ if alert_email != "" ~}

  alertmanager:
    image: ${alertmanager_image}
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    volumes:
      - /opt/testhunch/prometheus/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - /var/lib/testhunch/alertmanager:/alertmanager
%{ endif ~}
%{ if api_domain != "" ~}

  caddy:
    image: ${caddy_image}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/testhunch/Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/lib/testhunch/caddy:/data
      - /var/lib/testhunch/caddy-config:/config
    depends_on:
      api:
        condition: service_healthy
%{ endif ~}
EOF

# What a deployment runs, through the SSM document of the same name. It takes no argument: the
# image to run is whatever Parameter Store now says, so the deploying identity chooses a name and
# never a command (docs/adr/0026).
cat > /usr/local/bin/testhunch-deploy <<EOF
#!/usr/bin/env bash
set -euo pipefail
image="\$(aws ssm get-parameter --region '${region}' --name '${image_parameter}' \\
  --query Parameter.Value --output text)"

# Rewritten in place, in the directory only root can read: .env holds the database password.
umask 077
tmp="\$(mktemp /opt/testhunch/.env.XXXXXX)"
trap 'rm -f "\$tmp"' EXIT
grep -v '^TESTHUNCH_IMAGE=' /opt/testhunch/.env > "\$tmp"
printf 'TESTHUNCH_IMAGE=%s\n' "\$image" >> "\$tmp"
mv "\$tmp" /opt/testhunch/.env

cd /opt/testhunch
docker compose pull          # before the stop, so the API is down for a restart and not a download
systemctl restart testhunch.service
curl -fsS --retry 10 --retry-delay 3 --retry-connrefused http://127.0.0.1:8000/readyz
echo "testhunch now runs \$image"
EOF
chmod 0755 /usr/local/bin/testhunch-deploy

cat > /etc/systemd/system/testhunch.service <<'EOF'
[Unit]
Description=testhunch: Postgres and the API
Requires=docker.service
After=docker.service
# Never start on an empty directory because the disk was not mounted yet: that would initialise a
# second, empty database beside the real one.
RequiresMountsFor=/var/lib/testhunch

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/testhunch
ExecStart=/usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now testhunch.service

# A last word in the log, so `readyz` answering is what the setup ends on, not a guess.
curl -fsS --retry 10 --retry-delay 3 --retry-connrefused http://127.0.0.1:8000/readyz
echo "testhunch is up"
