{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "testhunch",
  "description": "Apprend de l'historique de votre CI quels tests un changement risque de casser.",
  "colors": {
    "primary": "#0E7C6B",
    "light": "#3DBFA8",
    "dark": "#0A5A4E"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0B0D0C"
    }
  },
  "fonts": {
    "family": "system-ui",
    "heading": { "family": "system-ui" },
    "body": { "family": "system-ui" }
  },
  "styling": {
    "codeblocks": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/docs/images/favicon.svg",
  "logo": {
    "light": "/docs/images/logo.svg",
    "dark": "/docs/images/logo-dark.svg",
    "href": "https://github.com/amazing-source/testhunch"
  },
  "navigation": {
    "groups": [
      {
        "group": "Prise en main",
        "pages": ["docs/index", "docs/demarrer"]
      },
      {
        "group": "Concepts",
        "pages": ["docs/concepts/classement"]
      },
      {
        "group": "En CI",
        "pages": ["docs/ci/action", "docs/ci/filet-de-securite"]
      },
      {
        "group": "Sauter des tests",
        "pages": [
          "docs/sauter/index",
          "docs/sauter/pytest",
          "docs/sauter/go",
          "docs/sauter/surefire",
          "docs/sauter/nextest",
          "docs/sauter/vitest",
          "docs/sauter/jest"
        ]
      },
      {
        "group": "Déployer",
        "pages": ["docs/deployer/docker", "docs/deployer/api"]
      },
      {
        "group": "Référence",
        "pages": ["docs/reference/cli", "docs/reference/environnement"]
      },
      {
        "group": "Mesures",
        "pages": ["docs/mesures/index"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Mesures",
        "href": "https://github.com/amazing-source/testhunch/blob/main/benchmarks/results/README.md"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/amazing-source/testhunch"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amazing-source/testhunch"
    }
  }
}
